{
  "name": "Pocket Sky",
  "short_name": "Sky",
  "description": "Your night sky: tonight's clear, dark hours, a star map you can hold up to the sky, sky events and an observing log.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#f5f6f8",
  "theme_color": "#3949ab",
  "icons": [
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png"
    }
  ],
  "shortcuts": [
    { "name": "Tonight", "url": "/" },
    { "name": "Sky map", "url": "/map" },
    { "name": "Log a night", "url": "/log?add=" }
  ]
}
